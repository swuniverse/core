{
  "name": "@swuniverse/source",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Star Wars Universe — A tick-based strategy browser game",
  "scripts": {
    "dev": "nx run-many --target=serve --projects=backend,frontend --parallel",
    "build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "typecheck": "nx run-many --target=typecheck --all",
    "typeorm:migrate": "TS_NODE_PROJECT=apps/backend/tsconfig.app.json node --require ts-node/register --require tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d apps/backend/src/database/typeorm-migration.config.ts",
    "typeorm:migrate:revert": "TS_NODE_PROJECT=apps/backend/tsconfig.app.json node --require ts-node/register --require tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d apps/backend/src/database/typeorm-migration.config.ts",
    "typeorm:migration:generate": "TS_NODE_PROJECT=apps/backend/tsconfig.app.json node --require ts-node/register --require tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate apps/backend/src/database/migrations/Generated -d apps/backend/src/database/typeorm-migration.config.ts",
    "typeorm:migration:create": "node --require ts-node/register --require tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create apps/backend/src/database/migrations/Manual",
    "docker:typeorm:migrate": "docker compose -f docker-compose.yml -f docker-compose.migrate.yml run --rm migrate",
    "docker:typeorm:migrate:revert": "docker compose -f docker-compose.yml -f docker-compose.migrate.yml run --rm migrate sh -lc \"npm ci --ignore-scripts && npm run typeorm:migrate:revert\""
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "22.7.1",
    "@nx/eslint-plugin": "22.7.1",
    "@nx/jest": "22.7.1",
    "@nx/js": "22.7.1",
    "@nx/nest": "^22.7.1",
    "@nx/node": "^22.7.1",
    "@nx/react": "^22.7.1",
    "@nx/vite": "^22.7.1",
    "@nx/vitest": "22.7.1",
    "@nx/web": "22.7.1",
    "@nx/webpack": "22.7.1",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@swc/jest": "~0.2.38",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "20.19.9",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "nx": "22.7.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.4",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0",
    "webpack-cli": "^5.1.4"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.1",
    "@nestjs/websockets": "^11.1.19",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.1.1",
    "nodemailer": "^8.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "typeorm": "^0.3.28",
    "zustand": "^5.0.12"
  }
}
