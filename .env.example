NODE_ENV=development
DB_PASSWORD=devpassword
DATABASE_URL=postgresql://swuniverse:devpassword@127.0.0.1:5490/swuniverse
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=changeme-generate-with-openssl-rand-base64-32
# Pepper for hashed email addresses of blocked players (never change after first use)
EMAIL_BLOCKLIST_PEPPER=changeme-generate-with-openssl-rand-base64-32
GAME_DATA_PATH=./game-data/data
TYPEORM_SYNCHRONIZE=false

# Gameplay timing (normal/default values if unset)
# Main tick normal schedule: 0,12,15,18,21 (5x per day)
# Alpha/testing: uncomment both lines for hourly main ticks and 50% build/queue times.
# GAME_MAIN_TICK_SCHEDULE_HOURS=*
# GAME_BUILD_TIME_MULTIPLIER=0.5
# Ion storms per galaxy layer: ceil(width × height / value), STU default 3000.
# ION_STORM_LOCATIONS_PER_STORM=3000
# IANA timezone for all scheduled game jobs.
GAME_TIMEZONE=Europe/Berlin

# Mail Setup (optional lokal; SMTP_PASS intentionally blank here)
# Ohne SMTP werden alle Mails mit Links ins lokale Backend-Log geschrieben.
# In Produktion sind SMTP_HOST, SMTP_USER, SMTP_PASS und MAIL_FROM_EMAIL Pflicht.
# Basis-URL fuer Links in Mails (Fallback: CORS_ORIGIN, dann http://localhost:5173)
PUBLIC_URL=http://localhost:5173
SMTP_HOST=mail.swuniverse.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@swuniverse.net
SMTP_PASS=
MAIL_FROM_NAME=Star Wars Universe
MAIL_FROM_EMAIL=noreply@swuniverse.net
# Receive failures from scheduled and manually run ticks (optional).
ADMIN_EMAIL=

# Scheduled idle-account maintenance always warns and deletes.
# Admin-only preview: POST /api/admin/idle-users/preview (no mail or deletion).
# Deadlines in days (STU defaults): inactive, on vacation, unverified registration.
IDLE_DELETION_DAYS=91.5
IDLE_DELETION_VACATION_DAYS=183
IDLE_UNVERIFIED_DAYS=3
APP_BASE_URL=http://localhost:5173

# Calendar-based Lebenstag gifts and spring capsules (Europe/Berlin); default on.
SEASONAL_ANOMALIES_ENABLED=true
