DB_PASSWORD=devpassword
DATABASE_URL=postgresql://swuniverse:devpassword@127.0.0.1:5490/swuniverse
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=changeme-generate-with-openssl-rand-base64-32
GAME_DATA_PATH=./game-data/data
TYPEORM_SYNCHRONIZE=false

# Gameplay timing (normal/default values if unset)
# Main tick normal schedule: 0,12,15,18,21 (5x per day)
# Alpha/testing: uncomment both lines for hourly main ticks and 50% build/queue times.
# GAME_MAIN_TICK_SCHEDULE_HOURS=*
# GAME_BUILD_TIME_MULTIPLIER=0.5

# Mail Setup (optional; SMTP_PASS intentionally blank here)
SMTP_HOST=mail.swuniverse.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@swuniverse.net
SMTP_PASS=
MAIL_FROM_NAME=Star Wars Universe
MAIL_FROM_EMAIL=noreply@swuniverse.net
