swuniverse.net {
	handle /api/* {
		reverse_proxy backend:3001
	}

	handle /socket.io/* {
		reverse_proxy backend:3001
	}

	handle {
		reverse_proxy frontend:5173
	}
}

wiki.swuniverse.net {
	reverse_proxy wiki:3000
}

mail.swuniverse.net, autodiscover.swuniverse.net, autoconfig.swuniverse.net {
	reverse_proxy nginx-mailcow:8080
}
