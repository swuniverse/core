#!/bin/sh
# Prevent pushing when submodule refs are out of sync (uncommitted submodule changes)

dirty_subs=$(git diff --name-only -- assets game-data 2>/dev/null)

if [ -n "$dirty_subs" ]; then
  echo ""
  echo "ERROR: Submodule refs not committed:"
  echo "$dirty_subs"
  echo ""
  echo "Run: git add assets game-data && git commit --amend --no-edit"
  echo ""
  exit 1
fi
